# M-Pesa Daraja API
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=your_consumer_key
MPESA_CONSUMER_SECRET=your_consumer_secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your_passkey
MPESA_INITIATOR_NAME=your_initiator
MPESA_SECURITY_CREDENTIAL=your_security_credential

# Callback URLs (must be HTTPS)
MPESA_STK_CALLBACK_URL=https://yourapp.com/api/mpesa/stk/callback
MPESA_C2B_CONFIRMATION_URL=https://yourapp.com/api/mpesa/c2b/confirmation
MPESA_C2B_VALIDATION_URL=https://yourapp.com/api/mpesa/c2b/validation
MPESA_B2C_RESULT_URL=https://yourapp.com/api/mpesa/b2c/result
MPESA_B2C_TIMEOUT_URL=https://yourapp.com/api/mpesa/b2c/timeout

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/mpesa_db

# Server
PORT=3000
API_KEY=your_api_key_for_dashboard_auth
